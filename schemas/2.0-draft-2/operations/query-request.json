{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcp.example/schemas/2.0-draft-2/operations/query-request.json",
  "title": "Query request",
  "description": "Query request. Defined in 5.2.1 of the HCP v2 specification (2.0-draft-2); where this schema and the text differ, the text governs.",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/category"
      }
    },
    "purpose": {
      "$ref": "../common.json#/$defs/purposeCode"
    },
    "purposeDescription": {
      "type": "string"
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "default": 5
    }
  },
  "required": [
    "query",
    "purpose"
  ]
}
